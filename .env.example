# ---------------------------------------------------------------------------
# Copy this file to ".env" for local development, then fill in the values.
# NEVER commit the real .env file and NEVER paste the real values into GitHub.
# On Render you type these same values into the dashboard instead.
# ---------------------------------------------------------------------------

# A long random string used by Flask to sign session cookies.
# Generate one in the terminal with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Name shown on the web page.
APP_NAME=Cloud Notes

# Database connection string.
# Local: use the SQLite file (comment out the PostgreSQL line below).
DATABASE_URL=sqlite:///cloud_notes.db
# Cloud (Render internal database URL - paste the one Render gives you):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Longest note allowed, in characters.
MAX_MESSAGE_LENGTH=500

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port used by the local server (Render sets PORT automatically - do not change it there).
PORT=5000